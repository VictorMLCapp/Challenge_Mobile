{
  "name": "ford-specs-api",
  "private": true,
  "version": "1.0.0",
  "description": "API de inteligência competitiva (Desafio 01) consumida pelo app Ford Ranger Raptor",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "simulate": "node scripts/simulate-traffic.js",
    "create-user": "node scripts/create-user.js",
    "seed:demo": "node scripts/seed-demo-users.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
