# Copie para .env e preencha. O .env NUNCA vai para o Git (.gitignore + Gitleaks no pipeline).
NODE_ENV=development
PORT=3000
METRICS_PORT=9464

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=15m

# Origens web aceitas pelo CORS (o app nativo usa CapacitorHttp e não envia Origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://localhost,capacitor://localhost

USERS_FILE=data/users.json
CATALOG_FILE=data/catalog.json
LOG_LEVEL=info
# LOG_FILE=logs/api.log

# Número de proxies reversos na frente da API (para o rate limit ver o IP real)
TRUST_PROXY=0
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILURES=5
